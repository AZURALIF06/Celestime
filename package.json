{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "site-map:generate": "node scripts/generate-site-map.mjs",
    "prebuild": "npm run site-map:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:cms-structure": "node --experimental-strip-types --test tests/cms-*.test.mjs",
    "test:cms-phase3b-scripts": "node scripts/test-cms-editor-canvas.mjs && node scripts/test-cms-responsive.mjs && node scripts/test-generic-cms-security.mjs",
    "test:cms": "npm run test:cms-structure && npm run test:cms-phase3b-scripts"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "^0.45.3",
    "jspdf": "^4.2.1",
    "next": "^16.3.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
